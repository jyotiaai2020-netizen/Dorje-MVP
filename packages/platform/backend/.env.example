APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./lotus.db
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
