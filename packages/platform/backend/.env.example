OLLAMA_VISION_MODEL=qwen3.5:0.8b
OLLAMA_REASONING_MODEL=deepseek-r1:1.5b
OLLAMA_REPORT_MODEL=qwen3:8b
OLLAMA_KEEP_ALIVE=15m
OLLAMA_CHAT_NUM_PREDICT=900
OLLAMA_REASONING_NUM_PREDICT=1200
OLLAMA_VISION_NUM_PREDICT=700
OLLAMA_REPORT_NUM_PREDICT=1600
ORCHESTRATOR_ENABLED=true
ORCHESTRATOR_MAX_VALIDATION_RETRIES=1
MODEL_IDLE_TIMEOUT_SECONDS=300
IMAGE_MODEL_ID=segmind/SSD-1B
IMAGE_TEST_MODEL_ID=segmind/tiny-sd
